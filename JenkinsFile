
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Chatino repository checked out successfully.'
            }
        }

        stage('Verify Docker') {
            steps {
                sh 'docker --version'
            }
        }

        stage('Build Frontend') {
            steps {
                sh 'docker build -t chatino-frontend:${BUILD_NUMBER} ./frontend'
            }
        }

        stage('Build Backend') {
            steps {
                sh 'docker build -t chatino-backend:${BUILD_NUMBER} ./backend'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment will be configured after Docker Hub setup.'
            }
        }
    }

    post {
        success {
            echo 'Chatino pipeline completed successfully!'
        }

        failure {
            echo 'Chatino pipeline failed. Check the console output.'
        }
    }
}
